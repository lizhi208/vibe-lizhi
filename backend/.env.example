# 服务端口
PORT=3000

# MySQL 数据库配置（先执行 database/schema.sql 建库）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=flea_market_ai

# 第三方大模型 API 配置（只调用，不训练）
AI_API_BASE_URL=https://api.example.com/v1
AI_API_KEY=your_api_key
AI_MODEL=your-multimodal-model

# 前端静态地址（CORS）
FRONTEND_ORIGIN=http://localhost:5500
