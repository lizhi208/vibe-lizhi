# 服务端口
PORT=8080

# MySQL 数据库配置（先执行 database/schema.sql 建库）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=flea_market_ai
# 云端 MySQL（如 Aiven）强制 SSL 时设为 true；本地留空或 false
DB_SSL=false

# 第三方大模型 API 配置（只调用，不训练；Key 只准待在后端，绝不进前端/不进 git）
# 默认阿里云百炼 OpenAI 兼容模式；换火山/硅基流动只需改这三行，零改码
AI_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 注册百炼后替换为真实 Key（sk-...）；未配置时 /api/ai/draft 自动 502 降级，不影响手动发布
AI_API_KEY=your_api_key
# 免费额度可用 qwen3-vl-plus（视觉识图）；纯文本模型 qwen-turbo 也可（用文件名做线索）
AI_MODEL=qwen3-vl-plus

# 前端静态地址（CORS）
FRONTEND_ORIGIN=http://localhost:5500
